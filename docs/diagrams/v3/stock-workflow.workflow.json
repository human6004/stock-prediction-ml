{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "HOSE ML - Three Independent Operating Flows",
    "subtitle": "Optional data refresh, one-model-at-a-time tuning, guarded official training, ordered release, and later inference",
    "output": "docs/diagrams/v3/stock-workflow.html"
  },
  "lanes": [
    { "id": "refresh", "label": "FLOW A - Optional Background Refresh" },
    { "id": "tuning", "label": "FLOW B - Manual Tuning (repeat per model)" },
    { "id": "preflight", "label": "FLOW C.1 - UI Preflight" },
    { "id": "pipeline", "label": "FLOW C.2 - Child Pipeline (read right to left)" },
    { "id": "publish", "label": "FLOW C.3 - Publish Outcome" },
    { "id": "serve", "label": "AFTER FLOW C - Prediction Serving" }
  ],
  "nodes": [
    { "id": "refresh_request", "lane": "refresh", "col": 0, "type": "frontend", "label": "Refresh", "sublabel": "POST /tuning/fetch-data", "tag": "lock precheck" },
    { "id": "refresh_worker", "lane": "refresh", "col": 2, "type": "backend", "label": "Background Job", "sublabel": "Popen + PID/log", "tag": "redirect status", "width": 100 },
    { "id": "refresh_fetch", "lane": "refresh", "col": 3, "type": "external", "label": "Fetch + Build", "sublabel": "raw -> clean / ML", "tag": "KBS retry + dedupe", "width": 100 },
    { "id": "refresh_status", "lane": "refresh", "col": 5, "type": "frontend", "label": "Refresh Status", "sublabel": "PID + log + report", "tag": "running / terminal", "width": 110 },

    { "id": "tune_request", "lane": "tuning", "col": 0, "type": "frontend", "label": "Tune Request", "sublabel": "one model params", "tag": "LR / RF / GB" },
    { "id": "cv", "lane": "tuning", "col": 2, "type": "backend", "label": "TRAIN CV", "sublabel": "5 folds, gap=5", "tag": "threshold per fold", "width": 100 },
    { "id": "history", "lane": "tuning", "col": 3, "type": "database", "label": "Run History", "sublabel": "ok / error", "tag": "metrics + time", "width": 100 },
    { "id": "save_config", "lane": "tuning", "col": 5, "type": "security", "label": "Save Config", "sublabel": "ok + same signature", "tag": "repeat until all 3", "width": 110 },

    { "id": "official_request", "lane": "preflight", "col": 0, "type": "frontend", "label": "Official Run", "sublabel": "separate POST", "tag": "manual action" },
    { "id": "ui_preflight", "lane": "preflight", "col": 2, "type": "security", "label": "UI Preflight", "sublabel": "three guards", "tag": "400 / 409 reject", "width": 110 },
    { "id": "start_child", "lane": "preflight", "col": 5, "type": "backend", "label": "Start Child", "sublabel": "subprocess.run", "tag": "UI waits + logs", "width": 110 },

    { "id": "rebuild", "lane": "pipeline", "col": 5, "type": "backend", "label": "Child Rebuild", "sublabel": "cleanup + split", "tag": "PID lock + finally", "width": 110 },
    { "id": "child_recheck", "lane": "pipeline", "col": 3, "type": "security", "label": "Child Recheck", "sublabel": "signature + TEST", "tag": "config after rebuild", "width": 100 },
    { "id": "fit", "lane": "pipeline", "col": 2, "type": "backend", "label": "Train 4 Models", "sublabel": "Dummy + 3 CV", "tag": "threshold on TRAIN", "width": 100 },
    { "id": "evaluate", "lane": "pipeline", "col": 0, "type": "backend", "label": "TEST 4 Models", "sublabel": "held-out metrics", "tag": "all artifacts" },

    { "id": "finalize", "lane": "publish", "col": 0, "type": "database", "label": "Select + Files", "sublabel": "non-Dummy; final + reports", "tag": "F1 > recall > simple" },
    { "id": "sqlite", "lane": "publish", "col": 2, "type": "database", "label": "SQLite Store", "sublabel": "mirrors + logs", "tag": "failure = warning", "width": 110 },
    { "id": "complete", "lane": "publish", "col": 5, "type": "security", "label": "Complete", "sublabel": "summary + lock", "tag": "model ready", "width": 110 },

    { "id": "client", "lane": "serve", "col": 0, "type": "frontend", "label": "Web / CLI", "sublabel": "submit symbol" },
    { "id": "inputs", "lane": "serve", "col": 2, "type": "backend", "label": "Load Inputs", "sublabel": "history + model", "tag": "metadata order", "width": 100 },
    { "id": "infer", "lane": "serve", "col": 3, "type": "backend", "label": "Latest + Infer", "sublabel": "features + cutoff", "width": 100 },
    { "id": "result", "lane": "serve", "col": 5, "type": "frontend", "label": "Prediction", "sublabel": "UP / NOT_UP", "tag": "probability", "width": 110 }
  ],
  "edges": [
    { "from": "refresh_request", "to": "refresh_worker", "label": "free; else 409", "variant": "security", "labelDy": -18 },
    { "from": "refresh_worker", "to": "refresh_fetch", "variant": "dashed" },
    { "from": "refresh_fetch", "to": "refresh_status", "variant": "emphasis" },

    { "from": "tune_request", "to": "cv", "variant": "default" },
    { "from": "cv", "to": "history", "variant": "emphasis" },
    { "from": "history", "to": "save_config", "label": "choose ok", "variant": "security", "labelDy": -18 },

    { "from": "official_request", "to": "ui_preflight", "variant": "emphasis" },
    { "from": "ui_preflight", "to": "start_child", "label": "pass", "variant": "emphasis", "labelDy": -18 },

    { "from": "start_child", "to": "rebuild", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "rebuild", "to": "child_recheck", "variant": "emphasis" },
    { "from": "child_recheck", "to": "fit", "variant": "security" },
    { "from": "fit", "to": "evaluate", "label": "held-out TEST", "variant": "emphasis", "labelDy": -18 },

    { "from": "evaluate", "to": "finalize", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "finalize", "to": "sqlite", "label": "sync attempt", "variant": "dashed", "labelDy": -18 },
    { "from": "sqlite", "to": "complete", "variant": "default" },

    { "from": "client", "to": "inputs", "label": "symbol", "variant": "emphasis", "labelDy": -18 },
    { "from": "inputs", "to": "infer", "variant": "emphasis" },
    { "from": "infer", "to": "result", "variant": "emphasis" }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Three Entry Points",
      "items": [
        "Refresh, tuning, and official run are separate user actions; cross-flow dependencies stay in notes, not long arrows",
        "Refresh is optional; tuning can use the existing ML dataset",
        "Saving a config never starts the official pipeline"
      ]
    },
    {
      "dot": "amber",
      "title": "Refresh + Tuning Truth",
      "items": [
        "Flask checks fetch/pipeline locks, spawns refresh_data.py, stores PID/log, and redirects to status",
        "Refresh may update raw CSV, then rebuilds clean, feature, and labeled files without training models",
        "Tuning Lab computes the dataset signature on its next request; retune only when that signature changed",
        "One tuning POST evaluates one model; history records ok/error; choose one current-signature run and repeat for LR, RF, GB"
      ]
    },
    {
      "dot": "rose",
      "title": "Two Guard Layers",
      "items": [
        "UI preflight checks three configs, current signature, TEST lock, fetch lock, and pipeline lock",
        "The child acquires its PID lock, rebuilds data, then rechecks signature, TEST, config schema, and all three keys",
        "Rejected preflight returns 400/409; child exceptions return nonzero, UI logs 500, and the PID lock is released in finally"
      ]
    },
    {
      "dot": "violet",
      "title": "Training Truth",
      "items": [
        "Dummy is fit-only; LR, RF, and GB rerun TimeSeriesSplit CV on TRAIN",
        "LR, RF, and GB tune their final decision thresholds on full TRAIN",
        "TEST evaluates all four artifacts; Dummy is excluded before F1, recall, and simplicity ranking"
      ]
    },
    {
      "dot": "emerald",
      "title": "Release + Serving",
      "items": [
        "File outputs are written directly; SQLite sync is best effort; summary and TEST lock complete the release",
        "Serving later reads clean history, final model, metadata, and saved feature order without retraining",
        "Flask attempts prediction logging; CLI logs only with --log-db; logging failure does not fail inference"
      ]
    }
  ]
}

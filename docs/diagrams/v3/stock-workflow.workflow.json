  "cards": [
    {
      "dot": "cyan",
      "title": "Manual Config Gate",
      "items": [
        "Tuning Lab validates hyperparameters server-side before each CV run",
        "Each selected run is tied to dataset fingerprint 4c2259e97b3f",
        "The official pipeline requires all 3 tunable models to be locked first"
      ]
    },
    {
      "dot": "emerald",
      "title": "Guarded Pipeline",
      "items": [
        "Features and labels are created per symbol; label columns are excluded from FEATURE_COLUMNS",
        "Train/test split uses label_end_date with no shuffle around 2025-12-31",
        "Dummy is evaluated as a baseline but cannot become the final model"
      ]
    },
    {
      "dot": "violet",
      "title": "Imbalance + Selection",
      "items": [
        "Class imbalance: LR class_weight=balanced, RF balanced_subsample, GB sample_weight=balanced into fit()",
        "Decision threshold is tuned for best F1 on each TRAIN fold, then applied to VAL (no leak)",
        "select_final_model ranks by f1_up, then recall_up, then simplicity (LR < RF < GB)"
      ]
    },
    {
      "dot": "rose",
      "title": "Current Result",
      "items": [
        "Random Forest wins on held-out test F1_UP 0.4816",
        "The selected decision threshold is 0.4049 for P(UP)",
        "Serving uses saved artifacts only; no training occurs inside prediction"
      ]
    }
  ]
}

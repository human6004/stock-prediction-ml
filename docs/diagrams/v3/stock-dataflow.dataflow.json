  "cards": [
    {
      "dot": "cyan",
      "title": "Preparation",
      "items": [
        "Clean CSV keeps all valid symbols; eligibility lists decide which 396 symbols enter training",
        "Feature calculations run independently per symbol and remove incomplete rolling windows",
        "Twenty features enter the model; future_close_5d and future_return_5d create labels only"
      ]
    },
    {
      "dot": "rose",
      "title": "Split + Evaluation",
      "items": [
        "TRAIN uses label_end_date at or before 2025-06-30; TEST uses later labels",
        "TimeSeriesSplit uses five folds and gap=5 rows on the pooled time-sorted TRAIN table",
        "A test lock records completed evaluation for the dataset fingerprint"
      ]
    },
    {
      "dot": "emerald",
      "title": "Serving",
      "items": [
        "Gradient Boosting is selected with recall_UP 0.9176 and decision threshold 0.4129",
        "Inference rebuilds the latest feature row from clean symbol history",
        "File artifacts are authoritative; SQLite is a mirror and prediction audit store"
      ]
    }
  ]

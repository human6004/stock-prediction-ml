  "cards": [
    {
      "dot": "cyan",
      "title": "Source + Cleaning",
      "items": [
        "fetch_hose_data.py normalizes vnstock/KBS columns and appends by symbol + trading_date",
        "clean_data removes missing rows, duplicates, invalid prices, invalid OHLC, and negative volume",
        "CRV, TCX, VCK, and VPX are excluded for fewer than 250 trading sessions"
      ]
    },
    {
      "dot": "rose",
      "title": "Leakage Control",
      "items": [
        "future_close_5d and future_return_5d create target only and never enter FEATURE_COLUMNS",
        "Train rows end at label_end_date 2025-12-31; test starts at label_end_date 2026-01-05",
        "TimeSeriesSplit gap 5 mirrors the 5-session prediction horizon"
      ]
    },
    {
      "dot": "violet",
      "title": "Model Training",
      "items": [
        "Class imbalance handled per model: LR class_weight=balanced, RF balanced_subsample, GB sample_weight=balanced into fit()",
        "Decision threshold tuned for best F1 on each TRAIN fold, then applied to the VAL fold (no leak), and saved to the artifact",
        "select_final_model drops the dummy and ranks by f1_up, then recall_up, then simplicity (LR < RF < GB)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Consumers",
      "items": [
        "Flask /evaluation reads model_comparison.csv and serves the confusion matrix image",
        "Prediction loads final_model.pkl, model_metadata.json, and clean symbol history",
        "SQLite mirrors raw, clean, features, tuning, evaluation, and prediction history"
      ]
    }
  ]
}

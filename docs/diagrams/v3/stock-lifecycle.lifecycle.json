{
  "schema_version": 1,
  "diagram_type": "lifecycle",
  "meta": {
    "title": "Official Pipeline Run Lifecycle",
    "subtitle": "Request gates, dataset rebuild, internal test guard, training, publication, best-effort DB sync, and terminal outcomes",
    "output": "docs/diagrams/v3/stock-lifecycle.html",
    "viewBox": [980, 700]
  },
  "lanes": [
    { "id": "main", "label": "Official pipeline phases" },
    { "id": "events", "label": "Internal guards + side effects" },
    { "id": "terminal", "label": "Terminal outcomes" }
  ],
  "states": [
    { "id": "requested", "type": "start", "label": "Requested", "sublabel": "POST or CLI", "lane": "main", "col": 0, "step": "01", "tag": "entry" },
    { "id": "launch_guard", "type": "decision", "label": "Launch Guard", "sublabel": "config + locks", "lane": "main", "col": 1, "step": "02", "tag": "UI path" },
    { "id": "prepare", "type": "active", "label": "Prepare Data", "sublabel": "clean feature split", "lane": "main", "col": 2, "step": "03", "tag": "fingerprint" },
    { "id": "train_test", "type": "active", "label": "Train + Test", "sublabel": "4 models", "lane": "main", "col": 3, "step": "04", "tag": "select GB" },
    { "id": "publish", "type": "success", "label": "Write Outputs", "sublabel": "model + reports", "lane": "main", "col": 4, "step": "05", "tag": "test lock" },

    { "id": "test_guard", "type": "decision", "label": "Internal Test Guard", "sublabel": "rebuilt fingerprint", "lane": "events", "col": 0, "tag": "unused TEST" },
    { "id": "db_sync", "type": "active", "label": "DB Sync", "sublabel": "SQLite mirrors", "lane": "events", "col": 1, "width": 110, "tag": "best effort" },
    { "id": "release_lock", "type": "neutral", "label": "Release Lock", "sublabel": "finally", "lane": "events", "col": 2, "width": 110, "tag": "always" },

    { "id": "blocked", "type": "failure", "label": "Blocked", "sublabel": "guard rejected", "lane": "terminal", "col": 0, "tag": "no run" },
    { "id": "failed", "type": "failure", "label": "Failed", "sublabel": "exception raised", "lane": "terminal", "col": 1, "tag": "lock released" },
    { "id": "ready", "type": "success", "label": "Model Ready", "sublabel": "Gradient Boosting", "lane": "terminal", "col": 2, "tag": "F1_UP 0.5053" }
  ],
  "transitions": [
    { "from": "launch_guard", "to": "blocked", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "prepare", "to": "test_guard", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "test_guard", "to": "blocked", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "test_guard", "to": "train_test", "label": "unused", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "left-channel", "labelSegment": 1 },
    { "from": "train_test", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "publish", "to": "db_sync", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "left-channel" },
    { "from": "publish", "to": "release_lock", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "db_sync", "to": "release_lock", "variant": "dashed", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "release_lock", "to": "ready", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "The app checks current configs, test lock, fetch lock, and pipeline lock before launch",
        "The child rebuilds data, recomputes the fingerprint, then checks TEST use again",
        "TRAIN-only CV and fitting precede one held-out TEST evaluation and model selection"
      ]
    },
    {
      "dot": "rose",
      "title": "Terminal Semantics",
      "items": [
        "Blocked means a guard rejected work before training",
        "Failed means an exception escaped preprocessing, training, evaluation, or publication",
        "The pipeline PID lock is released in finally on both success and failure"
      ]
    },
    {
      "dot": "amber",
      "title": "Side Effects + Scope",
      "items": [
        "SQLite sync failure becomes a summary warning; file artifacts remain authoritative",
        "The UI path prechecks TEST before launch, while run_pipeline checks after cleanup",
        "Standalone evaluate/select scripts do not enforce the official test lock"
      ]
    },
    {
      "dot": "violet",
      "title": "Current Terminal Release",
      "items": [
        "Fingerprint f6cb3ac8f820 is marked completed in test_evaluation_lock.json",
        "Gradient Boosting uses 20 features and decision threshold 0.4129",
        "Serving loads the published files without retraining"
      ]
    }
  ]
}

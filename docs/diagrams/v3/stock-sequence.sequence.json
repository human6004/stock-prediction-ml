  "cards": [
    {
      "dot": "cyan",
      "title": "Feature Contract",
      "items": [
        "The symbol is trimmed and uppercased before lookup",
        "Prediction rebuilds all 20 features from clean history and selects the latest row",
        "Feature order comes from model_metadata.json, matching training input order"
      ]
    },
    {
      "dot": "emerald",
      "title": "Inference",
      "items": [
        "joblib loads final_model.pkl; JSON supplies model name, feature order, and thresholds",
        "Gradient Boosting returns P(UP); UP requires probability at or above 0.4129",
        "Missing predict_proba support falls back to estimator.predict"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Behavior",
      "items": [
        "Missing symbol, insufficient history, or missing model files returns HTTP 400",
        "SQLite logging happens only after successful inference",
        "A logging exception is swallowed so the prediction page still renders"
      ]
    }
  ]

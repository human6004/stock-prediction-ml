  <diagram id="chatbot" name="4. Luồng chatbot (/api/chat)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1750" pageHeight="2150" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="cb_start" value="Người dùng gửi tin nhắn (/chat hoặc khung chat nổi)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="700" y="40" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cb_p1" value="POST /api/chat — kèm tối đa 6 tin gần nhất (transcript chia sẻ qua sessionStorage)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="150" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cb_p2" value="Validate payload: chỉ {message, history}; 1–1000 ký tự/tin; history xen kẽ user/assistant, tổng ≤ 6000 ký tự" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="700" y="270" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cb_d1" value="Hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="400" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb_e1" value="HTTP 400 — payload bị từ chối" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="415" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cb_p3" value="LLM CALL 1 — DECISION&#xa;DECISION_PROMPT + history → JSON {action, arguments} (1 trong 5 action)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="540" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cb_note1" value="Deadline chung 60s cho cả 2 LLM call (quá hạn → 504). History là untrusted: prompt buộc LLM bỏ qua chỉ thị nhúng trong history." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="1120" y="530" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cb_d2" value="JSON đúng schema?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="670" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb_e2" value="502 provider_protocol_error" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="1120" y="685" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cb_d3" value="Action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="740" y="810" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb_b1" value="GENERAL_CHAT — đáp xã giao; cấm nêu mã CK / số liệu; bỏ qua dispatcher và ML" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="40" y="950" width="260" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cb_b2" value="OUT_OF_SCOPE — từ chối theo 5 lý do: realtime, news, fundamentals, trading_advice (gợi ý dùng xếp hạng), other" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="330" y="950" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb_d4" value="STOCK_SIGNAL: mọi symbol ∈ scope (metadata.training_symbols)?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="710" y="950" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cb_b3n" value="Từ chối TOÀN BỘ request — unsupported_symbols + warning symbol_out_of_scope (không suy luận một phần)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="710" y="1100" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cb_b3y" value="prediction_service.predict_symbols() + cảnh báo stale / lệch ngày tham chiếu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="710" y="1220" width="260" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cb_b4" value="STOCK_RANKING — predict_all_symbols() → lọc scope, bỏ mã stale → sort probability_up → top_n (1–10)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1120" y="950" width="260" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cb_b5" value="PROJECT_INFO (7 topic) — overview/limitations: nội dung tĩnh; dataset/features: đọc CSV/report (503 nếu đang ghi); model/evaluation/inference: cần artifact + metadata (503 nếu thiếu)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="1410" y="950" width="260" height="130" as="geometry" />
        </mxCell>
        <mxCell id="cb_fmt" value="FORMATTER DETERMINISTIC — dựng answer tiếng Việt từ số liệu backend; câu tín hiệu / xếp hạng luôn kèm DISCLAIMER (không phải khuyến nghị đầu tư)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1">
          <mxGeometry x="700" y="1400" width="280" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cb_d5" value="_should_compose()? (compose bật VÀ action dữ liệu có kết quả thật)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="720" y="1560" width="240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="cb_p11" value="LLM CALL 2 — COMPOSE: viết lại tự nhiên ≤ 900 ký tự, chỉ dùng số backend, không Markdown/emoji, không khuyến nghị mua bán" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="700" y="1720" width="280" height="80" as="geometry" />
        </mxCell>
        <mxCell id="cb_d6" value="Compose hợp lệ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="730" y="1860" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="cb_keep" value="Lỗi / timeout / vi phạm → GIỮ bản deterministic" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1">
          <mxGeometry x="1120" y="1875" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="cb_end" value="JSON: answer, sources, warnings, data_as_of, model_trained_through" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">

  <diagram id="pipeline" name="2. Chi tiết run_pipeline.py (official)">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="3450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="pl_start" value="python scripts/run_pipeline.py (CLI hoặc POST /tuning/run-pipeline)" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_d0" value="Có tham số CLI?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="140" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl_err0" value="ValueError — official pipeline không nhận tham số" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="155" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_lock" value="acquire_pipeline_lock() — experiments/pipeline.lock (O_EXCL, reclaim nếu PID cũ đã chết)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="270" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_d1" value="Lock đang bận?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="410" y="380" width="240" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl_errL" value="In thông báo + sys.exit(1)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="395" width="280" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_s1" value="1) dataset_check() — đọc RAW_DATA_PATH, validate cột bắt buộc (thiếu file/cột → abort)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="510" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s2" value="2) clean_data() → cleaned_all + cleaned_for_training (in-memory, chưa ghi đĩa)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="620" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s3" value="3) build_features() — 20 feature kỹ thuật" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="730" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_s4" value="4) create_labels() — nhãn t+5 lịch thị trường chung (tăng &gt; 1% → UP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="830" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s5" value="5) protocol_time_split() — rolling: test_end = phiên mới nhất; validation_end = test_end − 94 ngày; train_end = validation_end − 274 ngày (fallback mốc tĩnh nếu span ≤ 368 ngày); purge hàng vắt ranh giới theo label_end_date" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="940" width="340" height="120" as="geometry" />
        </mxCell>
        <mxCell id="pl_s6" value="6) verify_protocol_splits() — 7 kiểm tra chống leakage giữa TRAIN / VALIDATION / TEST (fail → ValueError abort)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1100" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pl_s7" value="7) Fingerprint in-memory: dataset (scope TRAIN) + experiment (scope TRAIN+VAL+TEST) — SHA-256 không phụ thuộc thứ tự dòng" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1220" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pl_dsnap" value="8) Snapshot đã có trong evaluation_registry.json? (started / evaluated / published / release_failed đều tính)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="1340" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pl_errsnap" value="RuntimeError — TEST chỉ mở MỘT LẦN cho mỗi snapshot dữ liệu" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="1365" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_dconf" value="9) manual_config.json đủ LR + RF + GB, schema v4, đúng policy + fingerprint TRAIN?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="1490" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pl_errconf" value="RuntimeError — phải chốt config từ Tuning Lab trước" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="1515" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s10" value="10) Ghi outputs atomic: hose_stock_clean.csv, hose_stock_features.csv, ml_dataset.csv, split_summary.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1640" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pl_dfp" value="11) Fingerprint file vừa ghi khớp bản in-memory? (+ recheck registry)" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="1760" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pl_errfp" value="RuntimeError — fingerprint thay đổi sau khi ghi ml_dataset.csv" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="1785" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s12" value="12) tune_models(TRAIN) — REPLAY 3 config đã chốt (không CV lại): fit LR / RF / GB; ghi tuning_results.csv, cv_fold_results.csv, best_params.json" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="1910" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pl_s13" value="13) Chấm VALIDATION: 3 model + 2 baseline (Always-UP, Always-NOT_UP)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2050" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s14" value="14) select_final_model — tie-break: F1_UP giảm dần → Recall_UP → độ đơn giản (LR &lt; RF &lt; GB)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2160" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pl_dbase" value="15) F1_UP (winner, VALIDATION) &gt; baseline tốt nhất?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="2280" width="300" height="110" as="geometry" />
        </mxCell>
        <mxCell id="pl_errbase" value="RuntimeError — dừng TRƯỚC khi mở TEST (được phép chạy lại sau khi tune tốt hơn)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="820" y="2305" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s16" value="16) Ghi registry status=started — ĐIỂM KHÔNG QUAY LUI của snapshot" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="2430" width="340" height="80" as="geometry" />
        </mxCell>
        <mxCell id="pl_s17" value="17) Refit winner trên TRAIN+VALIDATION → chấm TEST MỘT lần với decision_threshold OOF của chính model (không phải 0.5)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2550" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl_dsoft" value="18) F1_UP TEST &gt; Always-UP TEST?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="380" y="2680" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="pl_warn" value="baseline_warning — chỉ cảnh báo, KHÔNG abort (TEST đã mở)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="820" y="2700" width="280" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_s19" value="19) Registry status=evaluated + test metrics" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2820" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_s20" value="20) write_reports — model_comparison, final_model_evaluation, classification_report, confusion_matrix (csv+png), feature_importance, model_selection_report" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="2920" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl_s21" value="21) atomic_model_release — stage tmp → backup bản cũ → os.replace final_model.pkl + model_metadata.json (lỗi → rollback từ backup)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="3050" width="340" height="90" as="geometry" />
        </mxCell>
        <mxCell id="pl_s22" value="22) Ghi pipeline_summary.json + registry status=published" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="360" y="3180" width="340" height="70" as="geometry" />
        </mxCell>
        <mxCell id="pl_end" value="Nhả pipeline.lock — hoàn tất, model mới phục vụ ngay" style="ellipse;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="360" y="3290" width="340" height="60" as="geometry" />
        </mxCell>
        <mxCell id="pl_exc" value="Exception BẤT KỲ sau khi TEST mở → registry: release_failed (đốt snapshot vĩnh viễn — model cũ tiếp tục phục vụ) → re-raise, exit ≠ 0; lock luôn được nhả (finally)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="3050" width="300" height="140" as="geometry" />
        </mxCell>

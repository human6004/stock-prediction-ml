  "cards": [
    {
      "dot": "cyan",
      "title": "Source Data",
      "items": [
        "The authoritative raw CSV lives in shared_dataset outside the repo",
        "fetch_hose_data.py appends incremental KBS/vnstock rows for 400 symbols",
        "The current raw date range is 2019-08-14 to 2026-06-26"
      ]
    },
    {
      "dot": "rose",
      "title": "Leakage Control",
      "items": [
        "future_close_5d and future_return_5d are label-only columns",
        "Train/test split uses label_end_date around 2025-12-31",
        "Prediction only uses the latest computed feature columns"
      ]
    },
    {
      "dot": "emerald",
      "title": "Consumers",
      "items": [
        "Flask reads model_comparison.csv for the evaluation page",
        "Prediction loads final_model.pkl and model_metadata.json",
        "SQLite mirrors data/report tables and stores prediction history"
      ]
    }
  ]

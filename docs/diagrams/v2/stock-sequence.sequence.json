  "cards": [
    {
      "dot": "emerald",
      "title": "Prediction Contract",
      "items": [
        "Input is normalized to an uppercase HOSE symbol",
        "The service returns label, probability_up, latest date, close, model, horizon, and threshold",
        "Gradient Boosting probability is shown as a model output, not investment certainty"
      ]
    },
    {
      "dot": "amber",
      "title": "Feature Handling",
      "items": [
        "Prediction recomputes current features from clean symbol history",
        "Feature order comes from model_metadata.json",
        "Future label columns are never used at prediction time"
      ]
    },
    {
      "dot": "rose",
      "title": "Failure Paths",
      "items": [
        "Missing symbol or insufficient history returns a 400 error on Flask",
        "Missing final_model.pkl asks the user to run the pipeline",
        "SQLite logging failures are swallowed so prediction can still render"
      ]
    }
  ]
}

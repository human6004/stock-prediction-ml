    { "from": "write_check", "to": "fit", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "via": [[625, 538], [88, 538]] },

    { "from": "fit", "to": "validation", "variant": "emphasis" },
    { "from": "validation", "to": "started", "variant": "security" },
    { "from": "started", "to": "test", "variant": "emphasis" },
    { "from": "test", "to": "evaluated", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "via": [[625, 662], [88, 662]] },

    { "from": "evaluated", "to": "reports", "variant": "default" },
    { "from": "reports", "to": "release", "variant": "emphasis" },
    { "from": "release", "to": "artifact", "variant": "emphasis" },
    { "from": "artifact", "to": "load", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "via": [[625, 786], [88, 786]] },

    { "from": "load", "to": "rebuild", "variant": "emphasis" },

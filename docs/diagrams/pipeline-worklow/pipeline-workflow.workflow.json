    { "id": "tuning", "label": "Tuning Lab · purged CV chỉ trên TRAIN" },
    { "id": "prepare", "label": "Official pipeline · re-derive và provenance guards" },
    { "id": "evaluate", "label": "Train và đánh giá · VALIDATION trước TEST" },
    { "id": "publish", "label": "Publish · registry, reports, atomic release" },
    { "id": "inference", "label": "Inference · dùng artifact đã publish" }

    { "id": "clean", "lane": "refresh", "col": 4, "type": "backend", "label": "Làm sạch", "sublabel": "preprocess_data", "tag": "eligible symbols", "width": 120 },

    { "id": "features", "lane": "dataset", "col": 0, "type": "backend", "label": "Đặc trưng", "sublabel": "build_features · 20 feature", "width": 92 },
    { "id": "labels", "lane": "dataset", "col": 2, "type": "database", "label": "Gán nhãn", "sublabel": "t+5 · tăng >1%", "width": 100 },
    { "id": "split", "lane": "dataset", "col": 4, "type": "backend", "label": "Rolling split", "sublabel": "TRAIN · VAL · TEST", "tag": "purge label_end", "width": 120 },


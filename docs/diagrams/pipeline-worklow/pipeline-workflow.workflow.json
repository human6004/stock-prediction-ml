    { "id": "history", "lane": "tuning", "col": 3, "type": "database", "label": "Tuning history", "sublabel": "run ok / error", "width": 92 },
    { "id": "manual", "lane": "tuning", "col": 5, "type": "security", "label": "Manual config", "sublabel": "user chọn 3 model", "tag": "schema v4", "width": 105 },


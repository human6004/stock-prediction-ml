{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Official pipeline — fingerprint, config gate, VALIDATION gate, TEST một lần, release",
    "subtitle": "run_pipeline.py: các nhánh config thiếu/stale · snapshot đã đánh giá · thua baseline · TEST thành công · release · release_failed",
    "output": "docs/diagrams/luuDo/03-workflow-tuning-den-release.html"
  },
  "lanes": [
    { "id": "entry", "label": "Trigger — POST run-pipeline" },
    { "id": "gate", "label": "Fingerprint + config + snapshot gate" },
    { "id": "train", "label": "TRAIN fit + VALIDATION selection" },
    { "id": "test", "label": "TEST một lần + refit" },
    { "id": "release", "label": "Publish artifact + registry" },
    { "id": "terminal", "label": "Dừng an toàn / release_failed" }
  ],
  "nodes": [
    { "id": "trigger", "lane": "entry", "col": 0, "type": "frontend", "label": "Official run", "sublabel": "run_pipeline.py", "width": 96 },
    { "id": "preflight", "lane": "entry", "col": 2, "type": "security", "label": "Preflight", "sublabel": "lock + đủ 3 config", "tag": "acquire lock", "width": 104 },
    { "id": "startBuild", "lane": "entry", "col": 5, "type": "backend", "label": "Rebuild RAM", "sublabel": "clean→feat→label→split", "width": 104 },

    { "id": "fingerprints", "lane": "gate", "col": 0, "type": "backend", "label": "Fingerprints", "sublabel": "TRAIN + experiment", "tag": "2 scope", "width": 92 },
    { "id": "snapshotGate", "lane": "gate", "col": 2, "type": "security", "label": "Snapshot?", "sublabel": "has_evaluated_snapshot", "width": 100 },
    { "id": "configGate", "lane": "gate", "col": 3, "type": "security", "label": "Config đủ?", "sublabel": "is_config_complete", "width": 100 },
    { "id": "recheck", "lane": "gate", "col": 5, "type": "database", "label": "Ghi CSV", "sublabel": "recheck fingerprint", "width": 104 },

    { "id": "fitTrain", "lane": "train", "col": 0, "type": "backend", "label": "Fit TRAIN", "sublabel": "LR/RF/GB · reuse CV", "tag": "3 model", "width": 92 },
    { "id": "scoreVal", "lane": "train", "col": 2, "type": "backend", "label": "Score VAL", "sublabel": "3 candidate + 2 baseline", "width": 100 },
    { "id": "selectGate", "lane": "train", "col": 3, "type": "security", "label": "Vượt baseline?", "sublabel": "F1_UP > baseline tốt nhất", "width": 100 },
    { "id": "regStarted", "lane": "train", "col": 5, "type": "database", "label": "registry", "sublabel": "started", "width": 104 },

    { "id": "refitTest", "lane": "test", "col": 2, "type": "security", "label": "Refit + TEST", "sublabel": "TRAIN+VAL · 1 lần", "tag": "duy nhất chạm TEST", "width": 110 },
    { "id": "regEval", "lane": "test", "col": 5, "type": "database", "label": "registry", "sublabel": "evaluated", "width": 104 },

    { "id": "reports", "lane": "release", "col": 0, "type": "database", "label": "Write reports", "sublabel": "CSV / JSON / PNG", "width": 96 },
    { "id": "atomicRelease", "lane": "release", "col": 2, "type": "database", "label": "Atomic release", "sublabel": "PKL + metadata", "tag": "rollback nếu lỗi", "width": 104 },
    { "id": "regPub", "lane": "release", "col": 5, "type": "backend", "label": "registry", "sublabel": "published", "tag": "release OK", "width": 104 },

    { "id": "stopSnapshot", "lane": "terminal", "col": 0, "type": "external", "label": "Dừng", "sublabel": "snapshot đã đánh giá", "tag": "không chạy lại TEST", "width": 96 },
    { "id": "stopConfig", "lane": "terminal", "col": 2, "type": "external", "label": "Dừng", "sublabel": "config thiếu / stale", "tag": "tune lại", "width": 104 },
    { "id": "stopBaseline", "lane": "terminal", "col": 3, "type": "external", "label": "Dừng", "sublabel": "winner thua baseline", "tag": "trước TEST", "width": 104 },
    { "id": "releaseFailed", "lane": "terminal", "col": 5, "type": "external", "label": "release_failed", "sublabel": "lỗi sau started", "tag": "release cũ còn", "width": 104 }
  ],
  "edges": [
    { "from": "trigger", "to": "preflight", "variant": "emphasis" },
    { "from": "preflight", "to": "startBuild", "variant": "emphasis" },
    { "from": "startBuild", "to": "fingerprints", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },

    { "from": "fingerprints", "to": "snapshotGate", "variant": "emphasis" },
    { "from": "snapshotGate", "to": "configGate", "variant": "emphasis" },
    { "from": "snapshotGate", "to": "stopSnapshot", "label": "đã đánh giá", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.35 },
    { "from": "configGate", "to": "recheck", "label": "đủ 3 config", "variant": "emphasis" },
    { "from": "configGate", "to": "stopConfig", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 },
    { "from": "recheck", "to": "fitTrain", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },

    { "from": "fitTrain", "to": "scoreVal", "variant": "emphasis" },
    { "from": "scoreVal", "to": "selectGate", "variant": "emphasis" },
    { "from": "selectGate", "to": "regStarted", "label": "vượt baseline", "variant": "emphasis" },
    { "from": "selectGate", "to": "stopBaseline", "label": "thua baseline", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 },
    { "from": "regStarted", "to": "refitTest", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },

    { "from": "refitTest", "to": "regEval", "variant": "emphasis" },
    { "from": "regEval", "to": "reports", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop" },

    { "from": "reports", "to": "atomicRelease", "variant": "emphasis" },
    { "from": "atomicRelease", "to": "regPub", "label": "publish", "variant": "emphasis" },
    { "from": "atomicRelease", "to": "releaseFailed", "label": "lỗi → rollback", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "Vào pipeline",
      "items": [
        "Bắt đầu bằng acquire lock và kiểm tra đủ 3 manual config; sau đó rebuild dataset trong RAM",
        "Tính TRAIN fingerprint và experiment fingerprint từ dataset hiện tại",
        "Ghi CSV rồi recheck fingerprint để bảo đảm dữ liệu ghi ra khớp bản trong RAM"
      ]
    },
    {
      "dot": "rose",
      "title": "Các nhánh dừng",
      "items": [
        "Snapshot đã đánh giá (has_evaluated_snapshot) → dừng, không chạy lại TEST cho cùng experiment fingerprint",
        "Config thiếu hoặc stale (fingerprint đổi) → dừng, yêu cầu tune lại 3 model",
        "Winner không vượt baseline tốt nhất trên VALIDATION → dừng trước khi chạm TEST"
      ]
    },
    {
      "dot": "emerald",
      "title": "TEST và release",
      "items": [
        "Chỉ khi vượt baseline mới ghi registry started rồi refit TRAIN+VALIDATION và chấm TEST đúng một lần",
        "registry chuyển started → evaluated → published; artifact publish atomic",
        "Lỗi sau khi đã started (gồm lỗi promotion) ghi release_failed và rollback; final_model.pkl cũ vẫn phục vụ"
      ]
    }
  ]
}

  "cards": [
    {
      "dot": "cyan",
      "title": "Runtime thật",
      "items": [
        "Flask monolith local tại 127.0.0.1:5000; HTML forms + Jinja, không có JSON REST API",
        "Trang /evaluation đọc report CSV/JSON/PNG đã sinh; không gọi model để tính lại",
        "Tuning Lab là một daemon thread trong process, chỉ chạy 4-fold CV trên TRAIN",
        "Official pipeline chặn request bằng subprocess.run; refresh chạy nền bằng Popen + PID lock + logfile"
      ]
    },
    {
      "dot": "emerald",
      "title": "Nguồn dữ liệu và serving",
      "items": [
        "Raw CSV nằm trong shared_dataset ngoài repo; refresh fetch cửa sổ riêng từng symbol rồi ghi atomic",
        "Prediction đọc clean CSV + final_model.pkl + model_metadata.json trực tiếp, không retrain",
        "Final Model phục vụ được đọc từ artifact; prediction horizon và threshold lấy động từ metadata",
        "Web gồm prediction, compare, evaluation, tuning và refresh status"
      ]
    },
    {
      "dot": "rose",
      "title": "Đã loại khỏi runtime",
      "items": [
        "Không còn SQLite: thư mục database/ đã xóa, không có mirror DB trên đường inference",
        "Không còn Dummy model hay intermediate tuned artifacts",
        "Không còn roadmap / document gate trong pipeline runtime"
      ]
    },
    {
      "dot": "amber",
      "title": "Giới hạn triển khai",
      "items": [
        "Không có auth, Docker, reverse proxy hay production WSGI trong repo",

    { "id": "terminal", "label": "Terminal outcomes" }
  ],
  "states": [
    { "id": "raw_ready", "type": "start", "label": "Raw Ready", "sublabel": "548074 rows", "lane": "main", "col": 0, "step": "01", "tag": "input" },
    { "id": "clean_feature", "type": "active", "label": "Clean+Feature", "sublabel": "15 signals", "lane": "main", "col": 1, "step": "02", "tag": "prep" },
    { "id": "train_tune", "type": "active", "label": "Train/Tune", "sublabel": "3 models+dummy", "lane": "main", "col": 2, "step": "03", "tag": "CV gap 5" },
    { "id": "evaluate", "type": "decision", "label": "Evaluate", "sublabel": "F1_UP gate", "lane": "main", "col": 3, "step": "04", "tag": "test set" },
    { "id": "serve", "type": "success", "label": "Serve", "sublabel": "Flask/CLI", "lane": "main", "col": 4, "step": "05", "tag": "offline" },
    { "id": "data_issue", "type": "waiting", "label": "Data Issue", "sublabel": "missing/invalid", "lane": "checks", "col": 0, "tag": "block" },
    { "id": "split_guard", "type": "decision", "label": "Split Guard", "sublabel": "label_end_date", "lane": "checks", "col": 1, "tag": "no leakage" },
    { "id": "db_sync", "type": "active", "label": "DB Sync", "sublabel": "SQLite tables", "lane": "checks", "col": 2, "tag": "sync/log" },
    { "id": "failed", "type": "failure", "label": "Pipeline Failed", "sublabel": "data/tuning error", "lane": "terminal", "col": 0, "tag": "stop" },
    { "id": "logged", "type": "success", "label": "Prediction Log", "sublabel": "history stored", "lane": "terminal", "col": 1, "tag": "optional" },
    { "id": "ready", "type": "success", "label": "Model Ready", "sublabel": "Random Forest", "lane": "terminal", "col": 2, "tag": "F1 0.439" }
  ],
  "transitions": [
    { "from": "raw_ready", "to": "data_issue", "label": "bad source", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "data_issue", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "clean_feature", "to": "split_guard", "label": "verify", "variant": "security", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "split_guard", "to": "train_tune", "label": "ok", "variant": "emphasis", "fromSide": "top", "toSide": "bottom", "route": "left-channel", "labelSegment": 1 },
    { "from": "evaluate", "to": "failed", "variant": "security", "fromSide": "bottom", "toSide": "top", "via": [[556, 342], [402, 342]] },
    { "from": "serve", "to": "db_sync", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "straight" },
    { "from": "db_sync", "to": "logged", "label": "prediction", "variant": "dashed", "fromSide": "bottom", "toSide": "top", "route": "drop", "labelSegment": 1 },
    { "from": "serve", "to": "ready", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "straight" }
  ],
  "cards": [
    {
      "dot": "emerald",
      "title": "Happy Path",
      "items": [
        "Raw data is validated, cleaned, featurized, labeled, split, trained, and evaluated",
        "Random Forest becomes the ready model when it wins by F1_UP",
        "Serving uses saved artifacts without retraining"
      ]
    },
    {
      "dot": "rose",
      "title": "Guard Rails",
      "items": [
        "Required columns, valid OHLC, and minimum trading days gate the pipeline",
        "verify_data_pipeline blocks label leakage into FEATURE_COLUMNS",
        "Dummy baseline is evaluated but cannot become final_model.pkl"
      ]
    },
    {
      "dot": "amber",
      "title": "Side Effects",
      "items": [
        "Reports and model metadata are regenerated during pipeline runs",
        "SQLite sync mirrors raw, clean, feature, tuning, and evaluation tables",
        "Prediction logging is optional and non-blocking for the user result"
      ]
    }
  ]
}

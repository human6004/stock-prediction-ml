  "meta": {
    "title": "Model Pipeline Lifecycle",
    "subtitle": "From raw data availability through leakage checks, model selection, serving, DB sync, and terminal outcomes",
    "output": "docs/diagrams/stock-lifecycle.html",
    "viewBox": [980, 700]
  },
  "lanes": [
    { "id": "main", "label": "Pipeline phases" },

{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Logistic Regression Tuning - Protocol v3",
    "subtitle": "Unlimited manual trials, 4-fold purged date CV, OOF-tuned decision threshold"
  },
  "lanes": [
    {"id": "params", "label": "Hyperparameters"},
    {"id": "cv", "label": "TRAIN cross-validation"},
    {"id": "result", "label": "Ranking + manual selection"}
  ],
  "nodes": [
    {"id": "lr", "lane": "params", "col": 0, "type": "backend", "label": "Logistic Reg.", "sublabel": "scaled + balanced", "width": 92},
    {"id": "c", "lane": "params", "col": 2, "type": "security", "label": "C", "sublabel": "> 0 (baseline 4.1e-7)", "width": 178},
    {"id": "solver", "lane": "params", "col": 5, "type": "security", "label": "solver", "sublabel": "lbfgs / liblinear", "width": 104},
    {"id": "dates", "lane": "cv", "col": 0, "type": "database", "label": "Trading dates", "sublabel": "whole-date folds", "width": 92},
    {"id": "folds", "lane": "cv", "col": 2, "type": "backend", "label": "4 temporary models", "sublabel": "gap 5 + label purge", "tag": "OOF threshold", "width": 122},
    {"id": "metrics", "lane": "cv", "col": 5, "type": "frontend", "label": "Fold metrics", "sublabel": "F1 / P / R", "width": 104},
    {"id": "rank", "lane": "result", "col": 2, "type": "backend", "label": "Rank valid runs", "sublabel": "mean desc, std asc, run_id asc", "width": 154},
    {"id": "best", "lane": "result", "col": 5, "type": "database", "label": "Best LR run", "sublabel": "user chooses when done", "tag": "no run limit", "width": 104}
  ],
  "edges": [
    {"from": "lr", "to": "c"},
    {"from": "c", "to": "solver"},
    {"from": "solver", "to": "folds", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "dates", "to": "folds"},
    {"from": "folds", "to": "metrics"},
    {"from": "metrics", "to": "rank", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "rank", "to": "best", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "rose", "title": "Manual trials", "items": ["Enter any valid C and solver", "Repeat until satisfied", "No fixed run count"]},
    {"dot": "cyan", "title": "Leakage controls", "items": ["Split by trading dates, never pooled rows", "Exactly five sessions between train and validation", "Purge label_end_date at validation boundary"]}
  ]
}

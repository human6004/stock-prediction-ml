{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Logistic Regression Tuning - Protocol v3",
    "subtitle": "Tuning Lab: unlimited manual trials, 4-fold purged date CV, one OOF decision threshold"
  },
  "lanes": [
    {"id": "form", "label": "1. Tuning Lab form (user input)"},
    {"id": "cv", "label": "2. Purged CV on TRAIN"},
    {"id": "thr", "label": "3. One threshold from pooled OOF"},
    {"id": "store", "label": "4. Provenance, history"}
  ],
  "nodes": [
    {"id": "lr", "lane": "form", "col": 0, "type": "backend", "label": "Logistic Reg.", "sublabel": "scaler + balanced", "width": 92},
    {"id": "c", "lane": "form", "col": 2, "type": "security", "label": "C", "sublabel": "float > 0 (form 4.1e-7)", "width": 154},
    {"id": "solver", "lane": "form", "col": 5, "type": "security", "label": "solver", "sublabel": "lbfgs / liblinear", "width": 104},

    {"id": "dates", "lane": "cv", "col": 0, "type": "database", "label": "CV date grid", "sublabel": "sessions >= 2021", "width": 92},
    {"id": "folds", "lane": "cv", "col": 2, "type": "backend", "label": "4 purged folds", "sublabel": "gap 5 + label purge", "tag": "fresh clone x4", "width": 154},
    {"id": "oof", "lane": "cv", "col": 5, "type": "frontend", "label": "Pooled OOF", "sublabel": "y + P(UP)", "width": 104},

    {"id": "gates", "lane": "thr", "col": 0, "type": "security", "label": "2 hard gates", "sublabel": "ratio, precision", "width": 92},
    {"id": "pick", "lane": "thr", "col": 2, "type": "backend", "label": "Pick 1 threshold", "sublabel": "max F1_UP, no 0.5 fallback", "tag": "0.05..0.95 step 0.01", "width": 154},
    {"id": "refold", "lane": "thr", "col": 5, "type": "frontend", "label": "Re-score folds", "sublabel": "F1/P/R + std", "width": 104},

    {"id": "prov", "lane": "store", "col": 0, "type": "security", "label": "Provenance", "sublabel": "4-fold recheck", "width": 92},
    {"id": "hist", "lane": "store", "col": 2, "type": "database", "label": "History row", "sublabel": "tuning_history.csv", "tag": "status ok / error", "width": 154},
    {"id": "use", "lane": "store", "col": 5, "type": "frontend", "label": "User picks run", "sublabel": "manual_config", "tag": "no run limit", "width": 104}
  ],
  "edges": [
    {"from": "lr", "to": "c"},
    {"from": "c", "to": "solver"},
    {"from": "solver", "to": "folds", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "dates", "to": "folds"},
    {"from": "folds", "to": "oof", "variant": "emphasis"},
    {"from": "oof", "to": "pick", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "gates", "to": "pick", "variant": "security"},
    {"from": "pick", "to": "refold", "variant": "emphasis"},
    {"from": "refold", "to": "hist", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "prov", "to": "hist", "variant": "security", "label": "pass"},
    {"from": "hist", "to": "use", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "rose", "title": "Manual trials", "items": ["Any valid C and solver, server-side validated", "Repeat with no run limit", "One job at a time; page refreshes every 5s"]},
    {"dot": "cyan", "title": "Leakage controls", "items": ["Folds cut whole trading dates, never pooled rows", "Five sessions between train and validation", "Train row needs label_end_date before validation"]},
    {"dot": "amber", "title": "Threshold gates", "items": ["predicted UP ratio <= 0.50", "precision >= OOF up_rate", "No valid threshold raises, no 0.5 fallback"]},
    {"dot": "slate", "title": "Fixed, not tunable", "items": ["StandardScaler inside the pipeline", "class_weight balanced, max_iter 1000", "random_state 42"]}
  ]
}

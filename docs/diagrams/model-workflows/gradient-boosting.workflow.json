{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Gradient Boosting Tuning - Protocol v3",
    "subtitle": "Unlimited manual trials, 4-fold purged date CV, OOF-tuned decision threshold"
  },
  "lanes": [
    {"id": "params", "label": "Highlighted GB hyperparameters"},
    {"id": "cv", "label": "TRAIN cross-validation"},
    {"id": "result", "label": "Ranking + manual selection"}
  ],
  "nodes": [
    {"id": "gb", "lane": "params", "col": 0, "type": "backend", "label": "GB model", "sublabel": "balanced weights", "width": 90},
    {"id": "trees", "lane": "params", "col": 2, "type": "security", "label": "n_estimators", "sublabel": "120; 60/180/240", "width": 104},
    {"id": "rate", "lane": "params", "col": 3, "type": "security", "label": "learning_rate", "sublabel": "(0,1] (baseline 0.2)", "width": 96},
    {"id": "depth", "lane": "params", "col": 5, "type": "security", "label": "max_depth", "sublabel": ">= 1 (baseline 2)", "width": 104},
    {"id": "sample", "lane": "cv", "col": 0, "type": "security", "label": "subsample", "sublabel": "(0,1] (baseline 0.9)", "width": 92},
    {"id": "folds", "lane": "cv", "col": 2, "type": "backend", "label": "One config x 4 folds", "sublabel": "repeat without limit", "tag": "OOF threshold", "width": 130},
    {"id": "metrics", "lane": "cv", "col": 5, "type": "frontend", "label": "Fold details", "sublabel": "dates + F1/P/R", "width": 104},
    {"id": "rank", "lane": "result", "col": 2, "type": "backend", "label": "Deterministic rank", "sublabel": "mean, std, run_id", "width": 126},
    {"id": "best", "lane": "result", "col": 5, "type": "database", "label": "Best GB run", "sublabel": "user chooses when done", "tag": "no run limit", "width": 104}
  ],
  "edges": [
    {"from": "gb", "to": "trees"},
    {"from": "trees", "to": "rate"},
    {"from": "rate", "to": "depth"},
    {"from": "depth", "to": "folds", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "sample", "to": "folds"},
    {"from": "folds", "to": "metrics"},
    {"from": "metrics", "to": "rank", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "rank", "to": "best", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "rose", "title": "Parameters highlighted", "items": ["n_estimators sets boosting stages", "learning_rate scales each stage", "max_depth and subsample control complexity"]},
    {"dot": "cyan", "title": "Fold contract", "items": ["Fresh clone in every fold", "Five trading-session gap", "No label overlap with validation"]}
  ]
}

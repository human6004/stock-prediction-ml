    { "id": "cv", "label": "GRADIENT BOOSTING - FIT + CV + THRESHOLD" },
    { "id": "result", "label": "GRADIENT BOOSTING - CV LÚC CHỐT + BỘ THAM SỐ ĐƯỢC CHỐT" }
  ],
  "nodes": [
    { "id": "fetch", "lane": "shared", "col": 0, "type": "external", "label": "Fetch", "sublabel": "vnstock / KBS", "tag": "SHARED", "width": 92 },
    { "id": "clean", "lane": "shared", "col": 1, "type": "external", "label": "Clean", "sublabel": "396 symbols", "tag": "OHLCV CHECKED", "width": 92 },
    { "id": "feature", "lane": "shared", "col": 3, "type": "external", "label": "20 Features + Label", "sublabel": "UP / NOT_UP", "tag": "SHARED", "width": 144 },
    { "id": "split", "lane": "shared", "col": 5, "type": "external", "label": "Time Split", "sublabel": "2025-06-30", "tag": "label_end_date", "width": 100 },

    { "id": "train", "lane": "config", "col": 0, "type": "external", "label": "TRAIN", "sublabel": "417,806 rows", "tag": "SHARED INPUT", "width": 92 },
    { "id": "hyperparams", "lane": "config", "col": 3, "type": "database", "label": "n_estimators | learning_rate", "sublabel": "max_depth | subsample", "tag": "MODEL-SPECIFIC | GRADIENT BOOSTING", "width": 400 },

    { "id": "fit", "lane": "cv", "col": 1, "type": "database", "label": "Fit Gradient Boosting", "sublabel": "sample_weight=balanced", "tag": "random_state=42", "width": 180 },
    { "id": "cv_split", "lane": "cv", "col": 3, "type": "external", "label": "TimeSeriesSplit CV", "sublabel": "TRAIN only | n_splits=5", "tag": "gap=5 pooled rows | no shuffle", "width": 160 },
    { "id": "threshold", "lane": "cv", "col": 5, "type": "external", "label": "Tune Threshold", "sublabel": "decision_threshold", "tag": "MAX F1_UP ON TRAIN-FOLD", "width": 108 },

    { "id": "cv_score", "lane": "result", "col": 0, "type": "database", "label": "CV LÚC CHỐT", "sublabel": "F1_UP=0.5453", "tag": "MEAN 5 VAL FOLDS", "width": 92 },
    { "id": "best_config", "lane": "result", "col": 3, "type": "database", "label": "n_estimators=120 | learning_rate=0.05", "sublabel": "max_depth=2 | subsample=1.0", "tag": "BỘ THAM SỐ ĐƯỢC CHỐT | manual_config.json", "width": 480 }
  ],
  "edges": [
    { "from": "fetch", "to": "clean", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "clean", "to": "feature", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "feature", "to": "split", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "split", "to": "train", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 },
    { "from": "train", "to": "hyperparams", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "hyperparams", "to": "fit", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 },
    { "from": "fit", "to": "cv_split", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "cv_split", "to": "threshold", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" },
    { "from": "threshold", "to": "cv_score", "variant": "default", "fromSide": "bottom", "toSide": "top", "route": "drop", "bias": 0.5 },
    { "from": "cv_score", "to": "best_config", "variant": "default", "fromSide": "right", "toSide": "left", "route": "straight" }

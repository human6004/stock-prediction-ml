      ]
    },
    {
      "dot": "cyan",
      "title": "Selected-run CV",
      "items": [
        "Run RF_20260716_211429 on fingerprint f6cb3ac8f820",
        "Mean validation F1_UP is 0.5491317453, displayed as 0.5491"
      ]
    },
    {
      "dot": "rose",
      "title": "Locked, not uniquely optimal",
      "items": [
        "max_features=0.35 is the configuration locked in manual_config.json",
        "Runs using 0.36 and 0.37 tied the same CV mean and standard deviation",
        "TEST evaluation and Final Model selection are shown in final-model-selection.html"
      ]
    }
  ]

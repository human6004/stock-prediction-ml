{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Random Forest Tuning - Protocol v3",
    "subtitle": "Unlimited manual trials, 4-fold purged date CV, OOF-tuned decision threshold"
  },
  "lanes": [
    {"id": "params", "label": "Highlighted RF hyperparameters"},
    {"id": "cv", "label": "TRAIN cross-validation"},
    {"id": "result", "label": "Ranking + manual selection"}
  ],
  "nodes": [
    {"id": "rf", "lane": "params", "col": 0, "type": "cloud", "label": "RF model", "sublabel": "balanced trees", "width": 90},
    {"id": "trees", "lane": "params", "col": 2, "type": "security", "label": "n_estimators", "sublabel": ">= 1 (baseline 130)", "width": 104},
    {"id": "depth", "lane": "params", "col": 3, "type": "security", "label": "max_depth", "sublabel": "int/None (base 6)", "width": 92},
    {"id": "leaf", "lane": "params", "col": 5, "type": "security", "label": "min leaf", "sublabel": ">= 1 (baseline 40)", "width": 104},
    {"id": "features", "lane": "cv", "col": 0, "type": "security", "label": "max features", "sublabel": "0.25; sqrt/log2", "width": 92},
    {"id": "folds", "lane": "cv", "col": 2, "type": "backend", "label": "One config x 4 folds", "sublabel": "repeat without limit", "tag": "OOF threshold", "width": 130},
    {"id": "metrics", "lane": "cv", "col": 5, "type": "frontend", "label": "Fold details", "sublabel": "dates + F1/P/R", "width": 104},
    {"id": "rank", "lane": "result", "col": 2, "type": "backend", "label": "Deterministic rank", "sublabel": "mean, std, run_id", "width": 126},
    {"id": "best", "lane": "result", "col": 5, "type": "database", "label": "Best RF run", "sublabel": "user chooses when done", "tag": "no run limit", "width": 104}
  ],
  "edges": [
    {"from": "rf", "to": "trees"},
    {"from": "trees", "to": "depth"},
    {"from": "depth", "to": "leaf"},
    {"from": "leaf", "to": "folds", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "features", "to": "folds"},
    {"from": "folds", "to": "metrics"},
    {"from": "metrics", "to": "rank", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "rank", "to": "best", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "rose", "title": "Manual trials", "items": ["Enter any valid parameters", "Repeat until satisfied", "No fixed run count"]},
    {"dot": "emerald", "title": "Selection", "items": ["Only current policy and content fingerprint", "Highest CV F1_UP mean wins", "Lower std and lower run_id break ties"]}
  ]
}

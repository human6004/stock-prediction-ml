{
  "schema_version": 1,
  "diagram_type": "workflow",
  "meta": {
    "title": "Final Model Selection - Protocol v3",
    "subtitle": "CV chooses configs, VALIDATION chooses family, TEST reports once at per-model threshold"
  },
  "lanes": [
    {"id": "tuning", "label": "TRAIN tuning"},
    {"id": "candidates", "label": "Full TRAIN candidates"},
    {"id": "validation", "label": "VALIDATION selection"},
    {"id": "test", "label": "Final TEST"},
    {"id": "release", "label": "Release and inference"}
  ],
  "nodes": [
    {"id": "lrbest", "lane": "tuning", "col": 0, "type": "backend", "label": "Chosen LR", "sublabel": "user-picked CV run"},
    {"id": "rfbest", "lane": "tuning", "col": 2, "type": "cloud", "label": "Chosen RF", "sublabel": "user-picked CV run"},
    {"id": "gbbest", "lane": "tuning", "col": 5, "type": "backend", "label": "Chosen GB", "sublabel": "user-picked CV run"},
    {"id": "lr", "lane": "candidates", "col": 0, "type": "backend", "label": "LR candidate", "sublabel": "fit all TRAIN"},
    {"id": "rf", "lane": "candidates", "col": 2, "type": "cloud", "label": "RF candidate", "sublabel": "fit all TRAIN"},
    {"id": "gb", "lane": "candidates", "col": 5, "type": "backend", "label": "GB candidate", "sublabel": "fit all TRAIN"},
    {"id": "compare", "lane": "validation", "col": 2, "type": "frontend", "label": "Compare on VALIDATION", "sublabel": "F1, Recall, simplicity LR→RF→GB", "tag": "each at own threshold", "width": 154},
    {"id": "baselinesv", "lane": "validation", "col": 5, "type": "database", "label": "Val baselines", "sublabel": "always-UP / NOT_UP", "width": 104},
    {"id": "refit", "lane": "test", "col": 0, "type": "backend", "label": "Fresh refit", "sublabel": "TRAIN + VALIDATION", "width": 92},
    {"id": "once", "lane": "test", "col": 2, "type": "security", "label": "TEST exactly once", "sublabel": "at artifact threshold", "tag": "locked", "width": 122},
    {"id": "baselinest", "lane": "test", "col": 5, "type": "database", "label": "TEST baselines", "sublabel": "pass flag", "width": 104},
    {"id": "atomic", "lane": "release", "col": 2, "type": "database", "label": "Atomic promotion", "sublabel": "exact tested artifact", "tag": "no post-TEST refit", "width": 132},
    {"id": "ui", "lane": "release", "col": 5, "type": "frontend", "label": "UI / CLI", "sublabel": "score >= threshold is UP", "width": 104}
  ],
  "edges": [
    {"from": "lrbest", "to": "lr", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "rfbest", "to": "rf", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "gbbest", "to": "gb", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "lr", "to": "compare", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "rf", "to": "compare", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "gb", "to": "compare", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "baselinesv", "to": "compare", "variant": "dashed"},
    {"from": "compare", "to": "refit", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "refit", "to": "once", "variant": "emphasis"},
    {"from": "once", "to": "baselinest"},
    {"from": "once", "to": "atomic", "variant": "emphasis", "fromSide": "bottom", "toSide": "top", "route": "drop"},
    {"from": "atomic", "to": "ui", "variant": "emphasis"}
  ],
  "cards": [
    {"dot": "emerald", "title": "Selection boundary", "items": ["CV selects one config inside each family", "VALIDATION selects the family", "TEST never participates in ranking"]},
    {"dot": "rose", "title": "Release rules", "items": ["Winner is fit fresh on TRAIN plus VALIDATION", "The exact tested object is promoted", "A failed pipeline keeps the active final model"]}
  ]
}

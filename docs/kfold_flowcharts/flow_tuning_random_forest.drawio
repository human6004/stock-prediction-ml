        <mxCell id="p2" value="Rút danh sách ngày giao dịch duy nhất&#xa;Bỏ các ngày trước 01/01/2021" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#41505f;strokeWidth=1.5;fontColor=#1f2933;fontFamily=Arial;fontSize=10.5;linespacing=1.25;" vertex="1" parent="1"><mxGeometry x="220" y="240" width="480" height="48" as="geometry" /></mxCell>

        <mxCell id="p6" value="Chọn một ngưỡng t từ toàn bộ OOF&#xa;Quét t = 0,05 → 0,95, bước 0,01&#xa;Bỏ t nếu up_rate &gt; 0,50 hoặc precision_UP &lt; tỷ lệ UP thực tế&#xa;Chọn t có F1_UP lớn nhất" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#41505f;strokeWidth=1.5;fontColor=#1f2933;fontFamily=Arial;fontSize=10;linespacing=1.25;" vertex="1" parent="1"><mxGeometry x="220" y="814" width="480" height="72" as="geometry" /></mxCell>
